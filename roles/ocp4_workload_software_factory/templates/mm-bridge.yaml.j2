# Mattermost <-> agent bridge: vendored from agent-office/cluster/mattermost/bridge
# The mm-bridge ServiceAccount drives openclaw agents via `oc exec` into
# their gateway pods, so it needs pods/exec + read on pods/AgentWorkstations.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: mm-bridge
  namespace: {{ ocp4_workload_software_factory_namespace }}
  labels: { app.kubernetes.io/part-of: agent-office }
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: mm-bridge
  namespace: {{ ocp4_workload_software_factory_namespace }}
rules:
  - apiGroups: [""]
    resources: [pods]
    verbs: [get, list]
  - apiGroups: [""]
    resources: [pods/exec]
    verbs: [create]
  - apiGroups: [agentoffice.ai]
    resources: [agentworkstations]
    verbs: [get, list]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: mm-bridge
  namespace: {{ ocp4_workload_software_factory_namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: mm-bridge
subjects:
  - kind: ServiceAccount
    name: mm-bridge
    namespace: {{ ocp4_workload_software_factory_namespace }}
---
# Dynamic seats: the bridge lists namespaces by label to find them …
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: mm-bridge-namespaces
rules:
  - apiGroups: [""]
    resources: [namespaces]
    verbs: [get, list]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: mm-bridge-namespaces
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: mm-bridge-namespaces
subjects:
  - kind: ServiceAccount
    name: mm-bridge
    namespace: {{ ocp4_workload_software_factory_namespace }}
---
# … and each seat namespace binds this ClusterRole to the bridge SA (the
# factory-hub seat policy does it at provisioning; the deployer's fixed
# seats carry an equivalent namespaced Role). Never bound cluster-wide.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: mm-bridge-seat
rules:
  - apiGroups: [""]
    resources: [pods]
    verbs: [get, list]
  - apiGroups: [""]
    resources: [pods/exec]
    verbs: [create]
  - apiGroups: [agentoffice.ai]
    resources: [agentworkstations]
    verbs: [get, list]
  # MCP gateway registrations in the seat: when one appears/changes, the
  # bridge reloads the seat's agent runtimes so they re-list governed tools.
  - apiGroups: [mcp.kuadrant.io]
    resources: [mcpserverregistrations]
    verbs: [get, list]
---
# openclaw <-> Mattermost bridge — in-cluster, durable.
# Watches every provisioned agent's channel + DM, drives the real openclaw
# agent (oc exec into its gateway), posts the reply as the bot. bridge.py is
# mounted from the mm-bridge-src ConfigMap (generated by kustomize).
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mm-bridge
  namespace: {{ ocp4_workload_software_factory_namespace }}
  labels: { app: mm-bridge }
spec:
  replicas: 1
  strategy: { type: Recreate }
  selector:
    matchLabels: { app: mm-bridge }
  template:
    metadata:
      labels: { app: mm-bridge }
    spec:
      serviceAccountName: mm-bridge
      containers:
        - name: bridge
          image: registry.access.redhat.com/ubi9/python-311:latest
          command: ["/bin/bash", "-c"]
          args:
            - |
              set -e
              curl -sL http://downloads.openshift-console.svc.cluster.local:80/amd64/linux/oc.tar -o /tmp/oc.tar
              tar -x -C /tmp -f /tmp/oc.tar oc
              export PATH=/tmp:$PATH
              # websocket-client → per-bot presence (green) + typing indicator.
              # Non-fatal: the bridge degrades to polling-only chat if absent.
              pip install --quiet --target=/tmp/pylibs websocket-client || echo "[bridge] WARN: websocket-client install failed"
              export PYTHONPATH=/tmp/pylibs:$PYTHONPATH
              echo "[bridge] deps ready"
              exec python3 /scripts/bridge.py
          env:
            - name: MM_URL
              value: http://mattermost.mattermost.svc.cluster.local:8065
            # WS must hit the SiteURL host (route) or Mattermost blocks the upgrade.
            - name: MM_WS_URL
              value: https://{{ mattermost_host }}
            - name: MM_ADMIN_TOKEN
              valueFrom:
                secretKeyRef: { name: mattermost-admin-token, key: token }
            - name: MM_TEAM
              value: agents
            # content guardrail (bridge.py screen()): Granite Guardian behind the
            # Guardrails Orchestrator in ns guardrails; fails closed.
            - name: GUARDRAILS_URL
              value: "{{ bridge_guardrails_url }}"
            - name: GUARDRAILS_DETECTOR
              value: granite-guardian
            - name: GUARDRAILS_BLOCK
              value: "sexual_content=0.5,illegal_activity=0.6,violence=0.7,harm=0.8,unethical_behavior=0.8,jailbreak=0.8"
            - name: GUARDRAILS_FAIL_CLOSED
              value: "{{ bridge_guardrails_fail_closed }}"
            - name: GW_NS
              # Shared namespace + every per-seat agent workspace (deployer
              # keeps this list in step with deploy/salamander-workspaces).
              value: {{ ocp4_workload_software_factory_namespace }}
          volumeMounts:
            - name: src
              mountPath: /scripts
          resources:
            requests: { cpu: 50m, memory: 128Mi }
            limits: { cpu: 500m, memory: 512Mi }
      volumes:
        - name: src
          configMap: { name: mm-bridge-src }
