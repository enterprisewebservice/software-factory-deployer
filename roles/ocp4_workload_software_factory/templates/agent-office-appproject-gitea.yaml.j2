# Shared, scoped ArgoCD AppProject for ALL Governed Agent Platform agents.
# Mirrors agent-office/cluster/agent-office-appproject.yaml with sourceRepos
# as the UNION of both providers — GitHub org repos AND the in-cluster
# Gitea's per-user orgs — because both publish paths stay live
# simultaneously. Gitea shape verified live on salamander 2026-08-24.
apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: agent-office
  namespace: openshift-gitops
  labels:
    app.kubernetes.io/managed-by: software-factory-deployer
spec:
  description: Shared scoped project for all Governed Agent Platform agents.
  sourceRepos:
    # GitHub side (reference-cluster contract, unchanged):
    - 'https://github.com/enterprisewebservice/*-agent-gitops.git'
    - 'https://github.com/enterprisewebservice/*-autoresearch-gitops.git'
    # Gitea side — attendee repos in per-user orgs: <user><suffix>/<name>-agent-gitops.
    - 'https://{{ gitea_host }}/*{{ gitea_user_org_suffix }}/*-agent-gitops.git'
    # ... and the services their dev agents ship (Module 6: the seat-services appset adopts them).
    - 'https://{{ gitea_host }}/*{{ gitea_user_org_suffix }}/*'
    - 'https://{{ gitea_host }}/*{{ gitea_user_org_suffix }}/*-autoresearch-gitops.git'
  destinations:
    - namespace: {{ ocp4_workload_software_factory_namespace }}
      server: https://kubernetes.default.svc
    # Attendee agent workspaces — one namespace per seat (see
    # deploy/salamander-workspaces): a hire's whole gitops repo (agent +
    # its own gateway) deploys into the attendee's namespace.
    - namespace: '*-agent-workspace'
      server: https://kubernetes.default.svc
  # Attendees sign in to the GitOps console with their workshop identity; without a
  # project role they see nothing. The workshop's OpenShift group gets read access to the
  # applications of this project (the guide reads an Application's tree and history; it
  # never asks an attendee to sync by hand). Subjects are groups, never user names.
  roles:
    - name: attendee
      description: Workshop attendees read the agent applications of this project
      policies:
        - p, proj:agent-office:attendee, applications, get, agent-office/*, allow
      groups:
        - {{ workshop_openshift_group }}
  clusterResourceWhitelist:
    - group: '*'
      kind: '*'
  namespaceResourceWhitelist:
    - group: '*'
      kind: '*'
