apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: "{{ item.name }}"
  namespace: "{{ item.ns }}"
spec:
  name: "{{ item.name }}"
  channel: "{{ item.channel }}"
  source: "{{ item.source }}"
  sourceNamespace: openshift-marketplace
  installPlanApproval: Automatic
{% if item.env is defined and item.env %}
  config:
    env:
{% for e in item.env %}
      - name: {{ e.name }}
{% if e.secretKeyRef is defined %}
        valueFrom:
          secretKeyRef:
            name: {{ e.secretKeyRef.name }}
            key: {{ e.secretKeyRef.key }}
{% else %}
        value: "{{ e.value }}"
{% endif %}
{% endfor %}
{% endif %}
