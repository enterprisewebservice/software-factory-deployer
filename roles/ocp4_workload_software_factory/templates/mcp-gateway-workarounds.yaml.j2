# RHCL 1.4 workarounds (Istio EnvoyFilters): Authorino over TLS, and 405 for GET /mcp.
# EnvoyFilter — make the MCP gateway's auth shim talk TLS to Authorino.
#
# Red Hat Connectivity Link runs Authorino's gRPC listener with TLS on
# (Authorino CR spec.listener.tls.enabled, cert = authorino-server-cert,
# signed by the OpenShift service CA). Kuadrant's own per-gateway
# EnvoyFilter (kuadrant-auth-<gateway>) defines the `kuadrant-auth-service`
# cluster in PLAINTEXT, so every wasm-shim -> Authorino check on this
# gateway failed at the TLS handshake and the shim failed closed with
# "gRPC status code is not OK" / HTTP 500 for every caller (2026-09-02).
#
# On the MaaS gateways the gap is closed by odh-model-controller, which
# gives each Gateway an EnvoyFilter `<gateway>-authn-ssl` (priority -1)
# that re-declares the same cluster with a TLS transport socket trusting
# the pod's service-ca.crt. This is that filter, verbatim in shape, for
# our Gateway (which no RHOAI controller manages). Lower priority applies
# first, so this declaration wins over Kuadrant's plaintext one — exactly
# as on maas-default-gateway / openshift-ai-inference.
apiVersion: networking.istio.io/v1alpha3
kind: EnvoyFilter
metadata:
  name: mcp-gateway-authn-ssl
  namespace: {{ ocp4_workload_software_factory_namespace }}
  labels:
    app.kubernetes.io/name: mcp-gateway
    app.kubernetes.io/component: authorino-tls
    app.kubernetes.io/managed-by: agent-office-gitops
spec:
  priority: -1
  targetRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: mcp-gateway
  configPatches:
    - applyTo: CLUSTER
      match:
        cluster:
          service: authorino-authorino-authorization.kuadrant-system.svc.cluster.local
      patch:
        operation: ADD
        value:
          name: kuadrant-auth-service
          type: STRICT_DNS
          connect_timeout: 1s
          lb_policy: ROUND_ROBIN
          http2_protocol_options: {}
          load_assignment:
            cluster_name: kuadrant-auth-service
            endpoints:
              - lb_endpoints:
                  - endpoint:
                      address:
                        socket_address:
                          address: authorino-authorino-authorization.kuadrant-system.svc.cluster.local
                          port_value: 50051
          transport_socket:
            name: envoy.transport_sockets.tls
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
              common_tls_context:
                validation_context:
                  trusted_ca:
                    filename: /var/run/secrets/kubernetes.io/serviceaccount/service-ca.crt
---
# Make GET /mcp return 405 at the Istio MCP gateway.
#
# WHY: the Kuadrant MCP broker answers GET /mcp (the OPTIONAL streamable-HTTP
# server-notification stream) with `200` + a SILENT SSE stream that never
# sends data. Its own backend (github-mcp-server) correctly returns 405 there.
# openclaw's MCP client opens that GET stream and, on a 200, waits for the
# stream to deliver something — it never does, so after 30s the client times
# out and abandons the ENTIRE server ("failed to start server github"). Result:
# agents load ZERO governed MCP tools.
#
# openclaw handles 405 perfectly — its client does `if (status===405) return;`
# and proceeds POST-only, which is all the tools need (POST request/response
# works flawlessly; that's how the projectboard_* tools were proven e2e).
#
# So: short-circuit GET /mcp to 405 BEFORE it reaches the broker. POST /mcp
# (every real tool call) is untouched and still flows through the broker, so
# governance/per-user filtering is fully preserved. Reversible: delete this.
apiVersion: networking.istio.io/v1alpha3
kind: EnvoyFilter
metadata:
  name: mcp-gateway-get-405
  namespace: {{ ocp4_workload_software_factory_namespace }}
  labels:
    app.kubernetes.io/managed-by: agent-office-gitops
spec:
  workloadSelector:
    labels:
      gateway.networking.k8s.io/gateway-name: mcp-gateway
  configPatches:
    - applyTo: HTTP_FILTER
      match:
        context: GATEWAY
        listener:
          filterChain:
            filter:
              name: envoy.filters.network.http_connection_manager
              subFilter:
                name: envoy.filters.http.router
      patch:
        operation: INSERT_BEFORE
        value:
          name: mcp-get-405.lua
          typed_config:
            "@type": type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua
            inlineCode: |
              function envoy_on_request(handle)
                local m = handle:headers():get(":method")
                local p = handle:headers():get(":path") or ""
                if m == "GET" and (p == "/mcp" or p:sub(1,5) == "/mcp/" or p:sub(1,5) == "/mcp?") then
                  handle:respond(
                    {[":status"] = "405", ["content-type"] = "text/plain", ["allow"] = "POST, DELETE"},
                    "Method Not Allowed: MCP server-notification stream is not supported; use POST."
                  )
                end
              end

